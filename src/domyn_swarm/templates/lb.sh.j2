#!/bin/bash
#SBATCH --account={{ cfg.backend.account }}
{% if cfg.backend.mail_user %}
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user={{ cfg.backend.mail_user }}
{% endif %}
#SBATCH --qos={{ cfg.backend.endpoint.qos or cfg.backend.qos }}

#SBATCH --exclusive
#SBATCH --job-name={{ job_name }}-lb
#SBATCH --partition={{ cfg.backend.partition }}
#SBATCH --nodes=1
#SBATCH --cpus-per-task={{ cfg.backend.endpoint.cpus_per_task }}
#SBATCH --mem={{ cfg.backend.endpoint.mem }}
#SBATCH --threads-per-core={{ cfg.backend.endpoint.threads_per_core }}
#SBATCH --time={{ cfg.backend.endpoint.wall_time }}
#SBATCH --output={{ swarm_directory }}/logs/endpoint/lb.out
#SBATCH --error={{ swarm_directory }}/logs/endpoint/lb.err

set -eu
REPLICAS={{ replicas }}
HOST_DIR="{{ swarm_directory }}"
SERVING_DIR="$HOST_DIR/serving"
WAIT_SEC={{ cfg.wait_endpoint_s | default(1800) }}
NGINX_IMG={{ cfg.backend.endpoint.nginx_image }}
PYTHON_IMG={{ cfg.image }}
INSTANCE_NAME="lb_${DEP_JOBID}_${SLURM_JOB_ID}"

COLLECTOR_PORT="${COLLECTOR_PORT:-{{ cfg.backend.endpoint.collector_port }}}"
COLLECTOR_HOST="$(hostname -f)"
COLLECTOR_LOG="$HOST_DIR/logs/collector.log"
COLLECTOR_READY_FILE="$HOST_DIR/run/collector.ready"

mkdir -p "$HOST_DIR" "$SERVING_DIR" "$HOST_DIR/run" "$HOST_DIR/logs"

{% set router = cfg.backend.endpoint.router %}
{% if router.type != "nginx" %}
# begin api key check
LB_API_KEY="${SINGULARITYENV_VLLM_API_KEY:-${VLLM_API_KEY:-${API_TOKEN:-}}}"
if [[ -n "$LB_API_KEY" && ! "$LB_API_KEY" =~ ^[A-Za-z0-9._~+/=-]+$ ]]; then
    echo "[lb] ERROR: the API key holds characters that the nginx check cannot match; use letters, digits and ._~+/=-" >&2
    exit 1
fi
(
    umask 077
    if [[ -n "$LB_API_KEY" ]]; then
        # nginx matches plain map keys case-insensitively, so use an anchored regex.
        escaped_key="${LB_API_KEY//./\\.}"
        escaped_key="${escaped_key//+/\\+}"
        printf 'map $http_authorization $dswarm_authorized { "~^Bearer %s$" 1; default 0; }\n' "$escaped_key"
    else
        printf 'map $http_authorization $dswarm_authorized { default 1; }\n'
    fi > "$SERVING_DIR/05-auth.conf"
)
# end api key check
{% endif %}
{% include "routers/" ~ router.type ~ ".sh.j2" %}


collector_cmd() {
  singularity exec --writable-tmpfs --bind "{{ collector_script_path }}:/opt/watchdog_collector.py,$HOST_DIR" "$PYTHON_IMG" \
    python3 /opt/watchdog_collector.py \
    --db "$HOST_DIR/watchdog.db" \
    --host "0.0.0.0" \
    --port "$COLLECTOR_PORT" \
    --ready-file "$COLLECTOR_READY_FILE"
}

{% include "_collector.sh.j2" %}

# Replicas block until this file exists, so write it up front: a collector that
# fails to start takes the whole job down a few lines below anyway.
{
    echo "COLLECTOR_HOST=$COLLECTOR_HOST"
    echo "COLLECTOR_PORT=$COLLECTOR_PORT"
} > "$SERVING_DIR/collector.env"

collector_start_or_die

trap 'echo "[lb] shutting down collector"; router_stop; kill $COLLECTOR_PID' EXIT

echo "[lb] waiting for $REPLICAS head files from job $DEP_JOBID"
t0=$(date +%s)
while true; do
    files=( $(ls "$SERVING_DIR/"*".head" 2>/dev/null || true) )
    {% raw %}
    if (( ${#files[@]} == REPLICAS )); then break; fi
    {% endraw %}
    if (( $(date +%s) - t0 > WAIT_SEC )); then
    {% raw %}
        echo "[lb] timeout: only ${#files[@]}/$REPLICAS replicas became healthy" >&2
    {% endraw %}
        exit 1
    fi
    sleep 5
done
echo "[lb] all replicas ready"

# Initial upstreams config (one-shot) before nginx starts.
singularity exec --writable-tmpfs --bind "{{ supervisor_script_path }}:/opt/lb_supervisor.py,$HOST_DIR" "$PYTHON_IMG" \
  python3 /opt/lb_supervisor.py --once \
  --serving-dir "$SERVING_DIR" \
  --upstream-keepalive {{ cfg.backend.endpoint.nginx_upstream_keepalive }} \
  {% if cfg.backend.requires_ray %}--ray-enabled --ray-dashboard-port {{ cfg.backend.ray_dashboard_port }} --ray-port {{ cfg.backend.ray_port }} {% endif %}{% if cfg.backend.endpoint.monitoring.enabled %}--emit-targets {% if cfg.backend.endpoint.monitoring.gpu_exporter.enabled %}--emit-gpu-targets {% endif %}{% if cfg.backend.endpoint.monitoring.ray_metrics.enabled %}--emit-ray-targets {% endif %}{% endif %}{% if router.type != "nginx" %}--router-address 127.0.0.1:$ROUTER_PORT {% endif %}

router_start
cp "$SERVING_DIR/replicas.txt" "$HOST_DIR/run/replicas.applied"

CACHE_DIR="$TMPDIR/cache"
mkdir -p "$CACHE_DIR"

singularity instance start --writable-tmpfs \
    -B "$HOST_DIR/nginx.conf:/etc/nginx/nginx.conf:ro" \
    -B "$SERVING_DIR:/etc/nginx/conf.d:ro" \
    -B "$HOST_DIR/run":/run \
    -B "$CACHE_DIR":/var/cache/nginx \
    -B "$HOST_DIR/logs/endpoint:/var/log/nginx" \
    "$NGINX_IMG" "$INSTANCE_NAME"

singularity exec instance://"$INSTANCE_NAME" bash -lc 'PATH=/usr/sbin:$PATH; nginx -t' \
  || { echo "[lb] ERROR: nginx config invalid" >&2; singularity instance stop "$INSTANCE_NAME" || true; exit 1; }
echo "[lb] started nginx instance '$INSTANCE_NAME'"

{% if cfg.backend.endpoint.monitoring.enabled %}
MON_PROM_DIR="$TMPDIR/prometheus"
mkdir -p "$MON_PROM_DIR"
{% if cfg.backend.endpoint.monitoring.mode == "container" %}
singularity exec --writable-tmpfs \
  -B "$SERVING_DIR:/etc/prometheus/serving:ro" \
  -B "$MON_PROM_DIR:/prometheus" \
  "{{ cfg.backend.endpoint.monitoring.prometheus_image }}" \
  prometheus --config.file=/etc/prometheus/serving/prometheus.yml \
    --storage.tsdb.path=/prometheus \
    --storage.tsdb.retention.time={{ cfg.backend.endpoint.monitoring.retention }} \
    --web.route-prefix={{ cfg.backend.endpoint.monitoring.route_prefix }}/ \
    --web.listen-address=127.0.0.1:{{ cfg.backend.endpoint.monitoring.port }} \
  >>"$HOST_DIR/logs/prometheus.log" 2>&1 &
PROM_PID=$!
singularity exec --writable-tmpfs "{{ cfg.backend.endpoint.monitoring.nginx_exporter_image }}" \
  nginx-prometheus-exporter \
    --nginx.scrape-uri=http://127.0.0.1:{{ cfg.backend.endpoint.port }}/nginx_status \
    --web.listen-address=127.0.0.1:{{ cfg.backend.endpoint.monitoring.exporter_port }} \
  >>"$HOST_DIR/logs/nginx_exporter.log" 2>&1 &
NGINX_EXP_PID=$!
{% else %}
{{ cfg.backend.endpoint.monitoring.prometheus_binary }} \
  --config.file="$SERVING_DIR/prometheus.yml" \
  --storage.tsdb.path="$MON_PROM_DIR" \
  --storage.tsdb.retention.time={{ cfg.backend.endpoint.monitoring.retention }} \
  --web.route-prefix={{ cfg.backend.endpoint.monitoring.route_prefix }}/ \
  --web.listen-address=127.0.0.1:{{ cfg.backend.endpoint.monitoring.port }} \
  >>"$HOST_DIR/logs/prometheus.log" 2>&1 &
PROM_PID=$!
{{ cfg.backend.endpoint.monitoring.nginx_exporter_binary }} \
  --nginx.scrape-uri=http://127.0.0.1:{{ cfg.backend.endpoint.port }}/nginx_status \
  --web.listen-address=127.0.0.1:{{ cfg.backend.endpoint.monitoring.exporter_port }} \
  >>"$HOST_DIR/logs/nginx_exporter.log" 2>&1 &
NGINX_EXP_PID=$!
{% endif %}
echo "[lb] started monitoring sidecars (prometheus=$PROM_PID, nginx_exporter=$NGINX_EXP_PID)"
{% endif %}

# Steady-state supervisor: keeps upstreams config in sync (generation only).
singularity exec --writable-tmpfs --bind "{{ supervisor_script_path }}:/opt/lb_supervisor.py,$HOST_DIR" "$PYTHON_IMG" \
  python3 /opt/lb_supervisor.py \
  --serving-dir "$SERVING_DIR" \
  --upstream-keepalive {{ cfg.backend.endpoint.nginx_upstream_keepalive }} \
  {% if cfg.backend.requires_ray %}--ray-enabled --ray-dashboard-port {{ cfg.backend.ray_dashboard_port }} --ray-port {{ cfg.backend.ray_port }} {% endif %}{% if cfg.backend.endpoint.monitoring.enabled %}--emit-targets {% if cfg.backend.endpoint.monitoring.gpu_exporter.enabled %}--emit-gpu-targets {% endif %}{% if cfg.backend.endpoint.monitoring.ray_metrics.enabled %}--emit-ray-targets {% endif %}{% endif %}{% if router.type != "nginx" %}--router-address 127.0.0.1:$ROUTER_PORT {% endif %}\
  >>"$HOST_DIR/logs/supervisor.log" 2>&1 &
SUPERVISOR_PID=$!
echo "[lb] started supervisor PID $SUPERVISOR_PID"

# Host-side nginx reloader: the supervisor (in a container) only regenerates config;
# nginx runs in its own PID namespace, so reload must happen from the host.
UPSTREAMS_FILE="$SERVING_DIR/00-upstreams.conf"
(
  last="$(md5sum "$UPSTREAMS_FILE" 2>/dev/null | awk '{print $1}')"
  while true; do
    cur="$(md5sum "$UPSTREAMS_FILE" 2>/dev/null | awk '{print $1}')"
    if [ -n "$cur" ] && [ "$cur" != "$last" ]; then
      if singularity exec instance://"$INSTANCE_NAME" bash -lc 'PATH=/usr/sbin:$PATH; nginx -t' >/dev/null 2>&1; then
        singularity exec instance://"$INSTANCE_NAME" bash -lc 'PATH=/usr/sbin:$PATH; nginx -s reload' \
          && echo "[lb] reloaded nginx (upstreams changed)" \
          && last="$cur"
      else
        echo "[lb] WARNING: nginx -t failed after upstreams change; keeping current config" >&2
      fi
    fi
    sleep 5
  done
) &
RELOAD_PID=$!
echo "[lb] started nginx reloader PID $RELOAD_PID"

REPLICAS_FILE="$SERVING_DIR/replicas.txt"
APPLIED_FILE="$HOST_DIR/run/replicas.applied"
(
  while true; do
    if [ -f "$REPLICAS_FILE" ] && ! cmp -s "$REPLICAS_FILE" "$APPLIED_FILE"; then
      # The supervisor may rewrite the list while a slow apply runs, so apply
      # and record one snapshot. After a failure the apply has already recorded
      # its successful calls in APPLIED_FILE, which must then stay as it is.
      cp "$REPLICAS_FILE" "$APPLIED_FILE.next"
      if router_apply_replicas "$APPLIED_FILE" "$APPLIED_FILE.next"; then
        mv "$APPLIED_FILE.next" "$APPLIED_FILE"
        echo "[lb] applied replica set to the router"
      else
        echo "[lb] WARNING: router did not take the whole replica set; retrying" >&2
      fi
    fi
    sleep 5
  done
) &
APPLY_PID=$!
echo "[lb] started router replica applier PID $APPLY_PID"

trap 'echo "[lb] shutting down"; router_stop; kill $COLLECTOR_PID $SUPERVISOR_PID ${RELOAD_PID:-} ${APPLY_PID:-} ${PROM_PID:-} ${NGINX_EXP_PID:-} 2>/dev/null; singularity instance stop "$INSTANCE_NAME" || true; exit 0' EXIT SIGTERM

wait $SUPERVISOR_PID
