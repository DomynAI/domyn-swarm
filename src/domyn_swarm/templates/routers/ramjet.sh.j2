{% from "routers/_common.sh.j2" import router_exec, router_wait_healthy, sh_quote %}
ROUTER_PORT={{ router.port }}
ROUTER_LOG="$HOST_DIR/logs/router.log"
ROUTER_PID_FILE="$HOST_DIR/run/router.pid"

router_start() {
    local upstream
    upstream="$(sed 's|^|http://|' "$SERVING_DIR/replicas.txt" | paste -sd, -)"
    (
        export RJ_UPSTREAM="$upstream"
        export RJ_API_ADDR=127.0.0.1:$ROUTER_PORT
        export RJ_METRICS_ADDR=127.0.0.1:{{ router.metrics_port }}
{% for key, value in router.policy_env().items() %}
        export {{ key }}={{ sh_quote(value) }}
{% endfor %}
{% for key, value in router.env.items() %}
        export {{ key }}={{ sh_quote(value) }}
{% endfor %}
        if [ -n "${LB_API_KEY:-}" ]; then export RJ_UPSTREAM_TOKEN="$LB_API_KEY"; fi
        exec {{ router_exec(router, run=True) }} {%+ for arg in router.args %}{{ sh_quote(arg) }} {% endfor %}\
            >>"$ROUTER_LOG" 2>&1
    ) &
    ROUTER_PID=$!
    echo "$ROUTER_PID" >"$ROUTER_PID_FILE"
{{ router_wait_healthy("ramjet") -}}
}

# The replica applier runs in a subshell and restarts the router there, so the
# PID file, not ROUTER_PID, tells the shutdown trap in the parent which process
# to stop. The wait keeps the next start from racing for the port.
router_stop() {
    local pid="${ROUTER_PID:-}" i
    [ -f "$ROUTER_PID_FILE" ] && pid="$(cat "$ROUTER_PID_FILE")"
    if [ -n "$pid" ]; then
        kill "$pid" 2>/dev/null || true
        for i in $(seq 1 20); do
            kill -0 "$pid" 2>/dev/null || break
            sleep 0.5
        done
        rm -f "$ROUTER_PID_FILE"
    fi
    ROUTER_PID=""
}

# Ramjet reads its upstream list only at start, so any change restarts it. The
# start runs in a subshell so that a failed health wait, which exits, makes the
# apply fail and retry instead of ending the applier loop.
router_apply_replicas() {
    router_stop
    ( router_start )
}
