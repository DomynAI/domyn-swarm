collector_publish_env() {
  {
    printf 'COLLECTOR_HOST=%q\n' "$COLLECTOR_HOST"
    printf 'COLLECTOR_PORT=%q\n' "$COLLECTOR_PORT"
{% if cfg.backend.endpoint.colocate %}
    printf 'COLLECTOR_ARRAY_JOB_ID=%q\n' "${SLURM_ARRAY_JOB_ID:-$DEP_JOBID}"
    printf 'COLLECTOR_RESTART_COUNT=%q\n' "${SLURM_RESTART_COUNT:-0}"
{% endif %}
  } > "$COLLECTOR_ENV_FILE.tmp"
  mv "$COLLECTOR_ENV_FILE.tmp" "$COLLECTOR_ENV_FILE"
}

collector_load_env() {
  local record
  record="$(cat "$COLLECTOR_ENV_FILE" 2>/dev/null)" || return 1
  COLLECTOR_HOST="" COLLECTOR_PORT=""
{% if cfg.backend.endpoint.colocate %}
  local COLLECTOR_ARRAY_JOB_ID="" COLLECTOR_RESTART_COUNT=""
{% endif %}
  source /dev/stdin <<< "$record" || return 1
  [[ -n "$COLLECTOR_HOST" && -n "$COLLECTOR_PORT" ]] || return 1
{% if cfg.backend.endpoint.colocate %}
  [[ "$COLLECTOR_ARRAY_JOB_ID" == "$REPL_JOB_ID" ]] || return 1
  local owner_job="${SLURM_ARRAY_JOB_ID:+${SLURM_ARRAY_JOB_ID}_0}"
  owner_job="${owner_job:-$SLURM_JOB_ID}"
  local job
  job="$(scontrol show job "$owner_job" -o 2>/dev/null)" || return 1
  [[ " $job " == *" JobState=RUNNING "* ]] || return 1
  # Other array tasks can restart independently, so use task zero's count.
  [[ " $job " =~ [[:space:]]Restarts=([0-9]+)[[:space:]] ]] || return 1
  [[ "$COLLECTOR_RESTART_COUNT" == "${BASH_REMATCH[1]}" ]] || return 1
{% endif %}
}
